    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "core-js": "^3.51.0",
    "lucide-react": "^1.20.0",
    "pdfjs-dist": "6.4.299",
    "postcss": "^8.5.31",
    "radix-ui": "^1.6.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.18.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zustand": "^5.0.14"
