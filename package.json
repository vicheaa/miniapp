  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
