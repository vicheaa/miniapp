# Optional direct backend origin, for example https://api.example.com.
# Leave empty to use relative URLs routed by the SuperApp.
VITE_API_ORIGIN=

# Optional local proxy target for /api, /services, /files, and /storage.
# Leave VITE_API_ORIGIN empty to send relative requests through this proxy.
VITE_DEV_PROXY_TARGET=

# Local testing only. Never commit real tokens; VITE_* values are public.
VITE_DEV_AUTH_TOKEN=
