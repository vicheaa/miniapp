# -----------------------------------------------------------------------------
# MiniApp Boilerplate - Environment Variables Template
# Copy this file to `.env` in the same directory and customize the values.
# -----------------------------------------------------------------------------

# Static auth token fallback used when running standalone in the browser (Mock Bridge mode)
# You can paste a JWT token from your login service here for testing API queries.
VITE_DEV_AUTH_TOKEN=your_jwt_auth_token_here

# Base URL of your backend API service.
# The local Vite development server will proxy requests matching /api/* and /services/* to this URL.
VITE_DEV_API_BASE_URL=http://localhost:8080
