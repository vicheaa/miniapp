# Copy to .env.dev for local development. Never commit real tokens.
VITE_DEV_AUTH_TOKEN=
# Optional local Vite proxy target; leave empty when no backend is needed.
VITE_API_BASE_URL=https://demo-pos.vietips.com
# Optional direct API origin for deployments without a host proxy (requires CORS).
VITE_POS_API_BASE_URL=

# Optional product image origin. Relative product paths use /storage/<path>.
VITE_POS_ASSET_BASE_URL=
