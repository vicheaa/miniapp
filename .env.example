# Optional direct backend origin, for example https://api.example.com.
# Leave empty to use relative URLs routed by the SuperApp.
VITE_API_ORIGIN=

# Optional local proxy target for /api, /services, /files, /storage, /central, and /media.
# Leave VITE_API_ORIGIN empty to send relative requests through this proxy.
# A configured proxy takes precedence during development; builds use VITE_API_ORIGIN.
# Use the backend root: catalog endpoint paths already include /services.
VITE_DEV_PROXY_TARGET=

# Local testing only. Never commit real tokens; VITE_* values are public.
VITE_DEV_AUTH_TOKEN=

# Temporary redacted auth tracing; honored only in staging builds.
VITE_AUTH_DIAGNOSTICS=false

# Browser key for Maps JavaScript API and Geocoding API, restricted to your app origins.
VITE_GOOGLE_MAPS_API_KEY=
